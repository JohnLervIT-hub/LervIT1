# ===== DATABASE =====
DATABASE_URL=postgresql://user:password@host/dbname

# ===== SESSION =====
# REQUIRED in production — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production

# ===== STRIPE =====
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLIC_KEY=pk_live_...
# Test-mode overrides (development only)
TESTING_STRIPE_SECRET_KEY=sk_test_...
TESTING_VITE_STRIPE_PUBLIC_KEY=pk_test_...

# ===== EMAIL (Resend) =====
RESEND_API_KEY=re_...

# ===== SMS + VOICE (Telnyx) =====
TELNYX_API_KEY=KEY...
TELNYX_MESSAGING_PROFILE_ID=...
# Voice caller ID (outbound admin calls, /api/admin/voice/*)
TELNYX_CALLER_ID=+18889820885
# SMS "from" number (Telnyx Messaging API)
TELNYX_SMS_FROM=+15878643866
# John's personal phone — destination for Xavier Cole (APEX) daily briefs
# and escalation alerts. E.164 format, e.g. +14035551234.
JOHN_PHONE_NUMBER=

# ===== NOVA VOICE AGENT (ElevenLabs Conversational AI) =====
# Agent ID from https://elevenlabs.io/app/conversational-ai — Nova streams
# answered-call audio to this agent over Telnyx media streaming.
ELEVENLABS_AGENT_ID=

# ===== SCOUT REID (HUNTER-D) =====
# Comma-separated list of Google Alerts RSS feed URLs. Create alerts at
# https://www.google.com/alerts (deliver via "RSS feed"), then paste the
# feed URLs here. Empty = Scout skips Google Alerts crawl cleanly.
# Example: https://www.google.com/alerts/feeds/XXXXXXXX/YYYYY,https://...
GOOGLE_ALERT_FEEDS=

# ===== ALEX MORGAN (CLOSER-D) =====
# Address Alex sends conversion + follow-up emails from. Must be a verified
# sender on your Resend domain. Display name is fixed as "Alex Morgan | LervIT".
ALEX_EMAIL=alex.morgan@lervit.com

# Address Riley sends congratulations + nudge emails from. Must be a verified
# sender on your Resend domain. Display name is fixed as "Riley Morgan | LervIT".
RILEY_EMAIL=riley.morgan@lervit.com

# Address Kai sends winback + reactivation emails from. Must be a verified
# sender on your Resend domain. Display name is fixed as "Kai Bennett | LervIT".
KAI_EMAIL=kai.bennett@lervit.com

# Address Sam sends B2B outbound + partner follow-up emails from. Must be a
# verified sender on your Resend domain. Display name is fixed as
# "Sam Carter | LervIT".
SAM_EMAIL=sam.carter@lervit.com

# ===== RYAN BROOKS (HUNTER-S) =====
# Comma-separated list of Google Alerts RSS feed URLs for supply-side signals
# (people offering moving/delivery work, van/truck for hire, etc.). Separate
# from GOOGLE_ALERT_FEEDS which feeds Scout's demand crawl. Empty = Ryan
# skips the Google Alerts leg of his crawl cleanly.
GOOGLE_ALERT_SUPPLY_FEEDS=

# ===== JORDAN HAYES (VETTER) =====
# Address Jordan sends recruitment + follow-up emails from. Must be a verified
# sender on your Resend domain. Display name is fixed as "Jordan Hayes | LervIT".
JORDAN_EMAIL=jordan.hayes@lervit.com

# rss2json.com API key. Free tier without a key is severely rate-limited
# (a few requests per minute); with a free-tier key it's 10,000/day.
# Sign up at https://rss2json.com and paste the api_key here.
# RSSBRIDGE_API_KEY (older name) is still read as a fallback for back-compat.
RSS2JSON_API_KEY=
RSSBRIDGE_API_KEY=

# ===== SCRAPINGBEE =====
# ScrapingBee HTML proxy for sources that block rss2json AND direct scrapers
# (Kijiji, RentFaster, Craigslist all return 403/500). Used only by the
# Scout Reid + Ryan Brooks scraped-listing crawlers — Reddit and Google
# Alerts continue through rss2json. If unset, those specific crawls skip
# with a WARN log; the rest of Scout/Ryan continue normally.
# Sign up at https://www.scrapingbee.com and paste the api key here.
SCRAPINGBEE_API_KEY=

# Set DISABLE_AGENT_WORKERS=1 to skip BullMQ workers on this process
# (mirrors DISABLE_BACKGROUND_JOBS=1). Leave unset in normal deployments.
DISABLE_AGENT_WORKERS=

# CHROMIUM_PATH was needed when Scout's Kijiji crawler used Puppeteer.
# All Scout sources now use RSS via rss2json (no browser), so this env
# var is no longer read by any code. Left as a comment for git-history
# breadcrumbs; delete the entry when convenient.

# NOTE: Twilio (TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER) is DEPRECATED.
# SMS is now handled by Telnyx. Do not add Twilio credentials — they are no longer used.

# ===== GOOGLE MAPS =====
VITE_GOOGLE_MAPS_API_KEY=AIza...
# Cloud-configured Map ID (required for AdvancedMarkerElement). Create one at
# https://console.cloud.google.com/google/maps-apis/studio/maps and attach any
# custom styling there. Falls back to Google's DEMO_MAP_ID if unset (dev only).
VITE_GOOGLE_MAPS_ID=DEMO_MAP_ID

# ===== OPENAI =====
OPENAI_API_KEY=sk-...

# ===== APP =====
NODE_ENV=production
PORT=5000
# Canonical public URL used in all email / SMS links. No trailing slash.
APP_BASE_URL=https://app.lervit.com

# ===== REDIS (BullMQ queue) =====
# Required for durable vision-analysis queue. Without this, jobs run in-memory
# and are lost on restart. Set to your Redis instance URL, e.g.:
#   redis://localhost:6379
#   rediss://user:pass@host:6380
REDIS_URL=

# ===== OPTIONAL =====
LOG_LEVEL=info
TZ=America/Edmonton
SERPAPI_API_KEY=
# DEPRECATED (Replit Object Storage sidecar) — remove after S3/R2 migration.
# See docs/OBJECT_STORAGE_MIGRATION.md for the migration plan.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ===== UPTIME MONITORING =====
# Configure an UptimeRobot monitor to ping GET /api/health every 5 minutes.
# Get your monitor URL from uptimerobot.com → My Monitors → Monitor URL.
UPTIME_ROBOT_URL=

# ===== WORKER PROCESS =====
# Cron jobs run in a separate process from the HTTP server.
# Start with: npm run worker   (dev: tsx server/worker.ts)
# In production, run server/worker.ts alongside server/index.ts as a separate process.
# Both processes require DATABASE_URL and all notification credentials above.

# ===== CANVA CONNECT =====
# canva.dev → your integration → Configuration (client id / secret), and
# Outside Canva → Redirect URLs → add ${APP_BASE_URL}/api/canva/callback
# An admin connects via the Connect Canva button on /admin. Tokens land in
# the app_settings table and refresh themselves; CANVA_ACCESS_TOKEN is only a
# fallback for a token pasted in by hand and cannot be refreshed.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_ACCESS_TOKEN=

# ===== MARKETING SITE (lervit.com) =====
# The marketing site generates lervit.com/sitemap.xml from GET /api/blog.
# Publishing a post POSTs to its /api/sitemap/regenerate so the new URL lands
# in the sitemap immediately instead of at the next cache expiry.
# INTERNAL_API_KEY must match the value on the marketing service. Use a long
# random value (e.g. `openssl rand -hex 32`), not a guessable string.
MARKETING_SITE_URL=https://lervit.com
INTERNAL_API_KEY=

# ===== GOOGLE BUSINESS PROFILE (GMB) =====
# Canonical Google Maps place ID for the LervIT listing. Used by
# /api/google-reviews (Places details) and by Kai's review-request SMS link.
# Previously a runtime textsearch for "LervIT Calgary moving" — pin it here so
# both read the same listing.
GOOGLE_PLACE_ID=ChIJwfu0I0JVUqgR6kpKN2fpsQA

# OAuth client from the Google Cloud console (Google My Business API +
# My Business Account Management API must both be enabled — the GMB API is
# allowlist-gated, see case 8-3924000041848).
GOOGLE_GMB_CLIENT_ID=
GOOGLE_GMB_CLIENT_SECRET=

# NOT YET ISSUED. Requires the one-time OAuth consent flow described at the
# top of server/lib/gmbClient.ts (scope business.manage, access_type=offline,
# prompt=consent). Until this is set in Railway, the review sync job and
# Ember's Google review replies skip with a warning instead of failing.
GOOGLE_GMB_REFRESH_TOKEN=

# Location to sync reviews for, as a bare id or "locations/{id}".
GOOGLE_GMB_LOCATION_ID=

# Optional — only needed if the OAuth user manages more than one GMB account.
# Unset = first account returned by the accounts endpoint.
GOOGLE_GMB_ACCOUNT_ID=
