omit=dev
# Puppeteer: skip the bundled Chromium download during npm ci.
# We install chromium via nixpacks.toml at the OS level; puppeteer.launch
# reads executablePath from CHROMIUM_PATH (or falls back to /usr/bin/chromium).
# Nixpacks also stops trying to auto-inject a PUPPETEER_CACHE_DIR ENV,
# which was producing a blank-name ENV line in the generated Dockerfile.
puppeteer_skip_chromium_download=true
PUPPETEER_SKIP_DOWNLOAD=true
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
